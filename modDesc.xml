<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="108">
    <author>Hunor</author>
    <version>1.0.0.0</version>
    <title>
        <en>VirtualTSZ Precision Farming Extension</en>
        <hu>VirtualTSZ Precision Farming kiegészítő</hu>
    </title>
    <description>
        <en><![CDATA[Extends Precision Farming with phosphorus (P), potassium (K) and organic matter maps. Spreading manure, slurry, digestate and fertilizers updates the layers, harvest removes nutrients, and a low level lowers the yield (never above what Precision Farming allows). Requires Precision Farming and the [TR] Precision Farming Configurator (2048 x 2048 maps).]]></en>
        <hu><![CDATA[A Precision Farming-et foszfor (P), kálium (K) és szervesanyag térképekkel bővíti. A trágya, hígtrágya, biogáz-iszap és műtrágyák kijuttatása frissíti a rétegeket, a betakarítás tápanyagot von el, az alacsony szint pedig csökkenti a termést (a Precision Farming által engedett érték fölé soha nem megy). Kell hozzá a Precision Farming és a [TR] Precision Farming Configurator (2048 x 2048 térképek).]]></hu>
    </description>
    <iconFilename>icon.dds</iconFilename>
    <multiplayer supported="true"/>
    <dependencies>
        <dependency>FS25_precisionFarming</dependency>
        <dependency>FS25_0_TRPFConfigurator</dependency>
    </dependencies>
    <l10n filenamePrefix="l10n/l10n"/>
    <fillTypes filename="xml/fillTypes.xml"/>
    <!-- spreader particle effect for the solid products (base FERTILIZER effect) -->
    <motionPathEffects filename="xml/motionPathEffects.xml"/>

    <storeItems>
        <storeItem xmlFilename="shop/bigBag_PETISO27.xml"/>
        <storeItem xmlFilename="shop/multiPurchase_bigBag_PETISO27.xml"/>
        <storeItem xmlFilename="shop/bigBag_KARBAMID46.xml"/>
