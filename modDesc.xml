        <storeItem xmlFilename="shop/bigBag_KALISO60.xml"/>
        <storeItem xmlFilename="shop/multiPurchase_bigBag_KALISO60.xml"/>
        <storeItem xmlFilename="shop/bigBag_PATENTKALI.xml"/>
        <storeItem xmlFilename="shop/multiPurchase_bigBag_PATENTKALI.xml"/>
        <storeItem xmlFilename="shop/bigBag_NPK15_15_15.xml"/>
        <storeItem xmlFilename="shop/multiPurchase_bigBag_NPK15_15_15.xml"/>
        <storeItem xmlFilename="shop/bigBag_NPK8_24_24.xml"/>
