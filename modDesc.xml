    <extraSourceFiles>
        <sourceFile filename="scripts/VtszNutrients.lua"/>
    </extraSourceFiles>
    <specializations>
        <specialization name="vtszSprayer" className="VtszSprayer" filename="scripts/VtszSprayer.lua"/>
    </specializations>
    <actions>
        <action name="VTSZ_RATE_INCREASE" category="VEHICLE" ignoreComboMask="false"/>
        <action name="VTSZ_RATE_DECREASE" category="VEHICLE" ignoreComboMask="false"/>
        <action name="VTSZ_MINIMAP_LAYER" category="VEHICLE" ignoreComboMask="false"/>
        <action name="VTSZ_AUTO_TOGGLE" category="VEHICLE" ignoreComboMask="false"/>
        <action name="VTSZ_AUTO_BASE" category="VEHICLE" ignoreComboMask="false"/>
    </actions>
    <inputBinding>
        <actionBinding action="VTSZ_RATE_INCREASE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_k" neutralInput="0" index="1"/>
        </actionBinding>
        <actionBinding action="VTSZ_RATE_DECREASE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_m" neutralInput="0" index="1"/>
        </actionBinding>
        <actionBinding action="VTSZ_MINIMAP_LAYER">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_period" neutralInput="0" index="1"/>
        </actionBinding>
        <actionBinding action="VTSZ_AUTO_TOGGLE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_comma" neutralInput="0" index="1"/>
        </actionBinding>
        <actionBinding action="VTSZ_AUTO_BASE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_b" neutralInput="0" index="1"/>
        </actionBinding>
    </inputBinding>

