        <sprayTypes>
            <sprayType name="PETISO27" type="FERTILIZER" litersPerSecond="0.0048" sprayGroundType="FERTILIZER">
                <applicationRate autoAdjustToFruit="true" regularRate="100">
                    <soil soilTypeIndex="1" rate="40"/>
                    <soil soilTypeIndex="2" rate="60"/>
                    <soil soilTypeIndex="3" rate="80"/>
                    <soil soilTypeIndex="4" rate="60"/>
                </applicationRate>
                <fertilizerUsage>
                    <nitrogen amount="0.27"/>
                </fertilizerUsage>
                <mapping group="FERTILIZER" isLiquid="false"/>
            </sprayType>
            <sprayType name="KARBAMID46" type="FERTILIZER" litersPerSecond="0.0064" sprayGroundType="FERTILIZER">
